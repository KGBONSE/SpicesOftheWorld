# Copy to .env.local and fill in. Never commit real values.

# --- Browser (safe to expose; protected by Row Level Security) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
VITE_SITE_URL=http://localhost:5173

# --- Import script ONLY (server-side, NEVER prefix with VITE_) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Stripe: set these as Supabase Edge Function secrets, not here ---
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_... STRIPE_WEBHOOK_SECRET=whsec_... \
#     STRIPE_PRICE_MONTHLY=price_... STRIPE_PRICE_ANNUAL=price_... SITE_URL=https://your-site
